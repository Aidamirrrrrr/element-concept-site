# Уведомления о заявках и заказах в Telegram.
# Скопируйте в .env и подставьте свои значения — .env в репозиторий не попадает.
#
# 1. Создайте бота у @BotFather, он выдаст токен.
# 2. Напишите боту любое сообщение (или добавьте его в группу).
# 3. Узнайте chat_id: откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    и возьмите значение result[0].message.chat.id
#
# Без этих переменных сайт работает как обычно: заявки просто
# пишутся в data/leads.txt и data/orders.txt.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ЮKassa: берутся в личном кабинете магазина. Без них заказ сохраняется как заявка.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный адрес сайта, куда ЮKassa вернёт покупателя после оплаты.
SITE_URL=https://elementconcept.ru

# Порт сервера (по умолчанию 3000)
# PORT=3000
